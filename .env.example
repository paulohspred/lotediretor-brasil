# Edge
HTTP_PORT=8080

# PostgreSQL
PLATFORM_DB_MIGRATION_USER=lotediretor
PLATFORM_DB_MIGRATION_PASSWORD=lotediretor_local
PLATFORM_DB_APP_USER=lotediretor_app
PLATFORM_DB_APP_PASSWORD=change-me-app
PLATFORM_DB_TILES_USER=lotediretor_tiles
PLATFORM_DB_TILES_PASSWORD=change-me-tiles
PLATFORM_DB_NAME=lotediretor
CONTROL_DB_MIGRATION_USER=lotediretor_control
CONTROL_DB_MIGRATION_PASSWORD=lotediretor_control_local
CONTROL_DB_APP_USER=lotediretor_control_app
CONTROL_DB_APP_PASSWORD=change-me-control-app
CONTROL_DB_NAME=lotediretor_control

# Keycloak local
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PUBLIC_ISSUER=http://localhost:8081/realms/lotediretor
KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/realms/lotediretor
OIDC_CLIENT_ID=lotediretor-app
OIDC_CLIENT_SECRET=local-lotediretor-secret
OIDC_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback
SESSION_COOKIE_SECURE=false
ALLOW_LOCAL_AUTO_MEMBERSHIP=true

# Sessions / internal service auth
VALKEY_URL=redis://valkey:6379/0
INTERNAL_API_TOKEN=local-internal-change-me
PLATFORM_INTERNAL_URL=http://platform-api:3001
CONTROL_INTERNAL_URL=http://control-api:3002
AI_GATEWAY_INTERNAL_URL=http://ai-gateway:3003
SOLAR_ENGINE_INTERNAL_URL=http://solar-engine:8001
AITEC_ENGINE_INTERNAL_URL=http://aitec-engine:8002

# NATS
NATS_URL=nats://nats:4222

# Object storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=lotediretor
S3_SECRET_KEY=lotediretor-local-secret
S3_BUCKET=lotediretor
S3_REGION=us-east-1
MAX_UPLOAD_BYTES=26214400

# Data pipelines
IBGE_SYNC_INTERVAL_SECONDS=86400

# AI provider: keep blank until evaluated adapter is approved
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Mercado Pago (sandbox/test locally)
MERCADOPAGO_WEBHOOK_SECRET=
MERCADO_PAGO_ACCESS_TOKEN=

# AI provider adapter (optional; evidence-grounded only)
AI_CHAT_ENDPOINT=
AI_TIMEOUT_MS=30000
# Optional evaluated fallback. It is never required for deterministic/lexical operation.
AI_FALLBACK_BASE_URL=
AI_FALLBACK_CHAT_ENDPOINT=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_FALLBACK_TIMEOUT_MS=30000
# Circuit breaker is per gateway process. Cost is reported only when explicit rates are configured.
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_RESET_MS=60000
AI_INPUT_COST_PER_1M_USD=
AI_OUTPUT_COST_PER_1M_USD=
AI_FALLBACK_INPUT_COST_PER_1M_USD=
AI_FALLBACK_OUTPUT_COST_PER_1M_USD=
AI_EMBEDDINGS_ENDPOINT=
AI_EMBEDDINGS_MODEL=
AI_EMBEDDINGS_API_KEY=
AI_EMBEDDINGS_DIMENSION=1536
AI_EMBEDDINGS_TIMEOUT_MS=20000
AI_EMBEDDINGS_TIMEOUT_SECONDS=20
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_EVIDENCE_INDEX=lotediretor-evidence-v3
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
MAX_JSON_BODY_BYTES=2097152

# Optional official/licensed source connectors. Discovery is not activation.
# CAR: configure only a verified official/authorized endpoint or controlled feed.
CAR_SOURCE_ENABLED=false
CAR_SOURCE_URL=
CAR_SOURCE_MODE=GEOJSON
CAR_SOURCE_TYPENAME=
CAR_SOURCE_SRS_NAME=EPSG:4326
CAR_SOURCE_LICENSE_URL=

# SIGEF uses a dedicated authorized Conecta integration, not the generic GeoJSON adapter.
SIGEF_SOURCE_ENABLED=false
SIGEF_CONECTA_BEARER=

# IBAMA Termos de Embargo official CKAN package; adapter selects SHP-ZIP and converts with GDAL.
IBAMA_EMBARGO_SOURCE_ENABLED=false
IBAMA_EMBARGO_SOURCE_URL=https://dadosabertos.ibama.gov.br/api/3/action/package_show?id=termos-de-embargo
IBAMA_EMBARGO_SOURCE_MODE=CKAN_SHP_ZIP_GDAL
IBAMA_EMBARGO_SOURCE_LICENSE_URL=https://opendatacommons.org/licenses/odbl/1-0/
IBAMA_EMBARGO_SOURCE_SRS_NAME=EPSG:4326

# TerraBrasilis WFS base. Inspect/pin an exact current PRODES typeName before enabling.
PRODES_SOURCE_ENABLED=false
PRODES_SOURCE_URL=https://terrabrasilis.dpi.inpe.br/geoserver/ows
PRODES_SOURCE_MODE=WFS
PRODES_SOURCE_TYPENAME=
PRODES_SOURCE_SRS_NAME=EPSG:4326
PRODES_SOURCE_LICENSE_URL=

# Operations / observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3005
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local
BACKUP_DIR=./backups

# v10 production edge (set in secret manager / deployment environment)
PUBLIC_DOMAIN=app.example.invalid
AUTH_DOMAIN=auth.example.invalid
ACME_EMAIL=ops@example.invalid

# v12 observability/retention
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
BACKUP_RETENTION_DAYS=14
PLATFORM_DB_EVENT_PASSWORD=change-me-events
PLATFORM_DB_WORKER_PASSWORD=change-me-worker
CONTROL_DB_WORKER_PASSWORD=change-me-control-worker

# Do not commit real values. Load secrets from a secret manager/environment.
# Application *_IMAGE values must be registry references pinned with @sha256.
PUBLIC_DOMAIN=
AUTH_DOMAIN=
ACME_EMAIL=
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
OIDC_CLIENT_SECRET=
INTERNAL_API_TOKEN=

PLATFORM_DB_MIGRATION_USER=lotediretor
PLATFORM_DB_MIGRATION_PASSWORD=
PLATFORM_DB_NAME=lotediretor
PLATFORM_DB_APP_USER=lotediretor_app
PLATFORM_DB_APP_PASSWORD=
PLATFORM_DB_TILES_USER=lotediretor_tiles
PLATFORM_DB_TILES_PASSWORD=
PLATFORM_DB_EVENT_PASSWORD=
PLATFORM_DB_WORKER_PASSWORD=

CONTROL_DB_MIGRATION_USER=lotediretor_control
CONTROL_DB_MIGRATION_PASSWORD=
CONTROL_DB_NAME=lotediretor_control
CONTROL_DB_APP_USER=lotediretor_control_app
CONTROL_DB_APP_PASSWORD=
CONTROL_DB_WORKER_PASSWORD=

S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=lotediretor
# Confirmed official archived MinIO image tags used by the portable Compose fixture.
# A managed/external object-storage provider may replace this topology in final production.
MINIO_IMAGE=minio/minio:RELEASE.2025-07-23T15-54-02Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z

MERCADOPAGO_WEBHOOK_SECRET=
MERCADO_PAGO_ACCESS_TOKEN=
SESSION_COOKIE_SECURE=true
ALLOW_LOCAL_AUTO_MEMBERSHIP=false
NATS_URL=nats://nats:4222
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
AITEC_JOB_RETRY_BASE_SECONDS=5
AITEC_JOB_RETRY_MAX_SECONDS=60

# Immutable application promotion set. Example format:
# ghcr.io/your-org/platform-api@sha256:<64-hex-digest>
PLATFORM_API_IMAGE=
CONTROL_API_IMAGE=
AI_GATEWAY_IMAGE=
SOLAR_ENGINE_IMAGE=
AITEC_ENGINE_IMAGE=
AITEC_WORKER_IMAGE=
